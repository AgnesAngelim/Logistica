rules_version = '2';

// Regras do Painel de Chamados — Logística de Chip
// Cole no Firebase Console → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado()   { return request.auth != null; }
    function email()    { return request.auth.token.email.lower(); }

    // Veem e gerenciam tudo
    function isAdmin() {
      return logado() && email() in [
        'agnes.angelim@igreenenergy.com.br',
        'anacarolina.araujo@igreenenergy.com.br'
      ];
    }
    // Responsável pelos chamados de Chip
    function isRespChip() { return logado() && email() == 'mariajulia.mendes@igreenenergy.com.br'; }

    function podeGerir(cat) {
      return isAdmin() || (cat == 'chip' && isRespChip());
    }

    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    match /chamados/{id} {
      // Todos veem tudo, exceto Maria Julia, que vê os chamados de Chip + o que ela abriu
      allow read: if isAdmin()
        || (logado() && !isRespChip())
        || podeGerir(resource.data.categoria)
        || (logado() && resource.data.criadoPor.uid == request.auth.uid);

      // Qualquer usuário logado abre chamado, sempre como "aberto" e na área Chip
      allow create: if logado()
        && request.resource.data.criadoPor.uid == request.auth.uid
        && request.resource.data.categoria == 'chip'
        && request.resource.data.status == 'aberto';

      // Muda status / comenta: admins e a responsável de Chip
      allow update: if isAdmin()
        || (podeGerir(resource.data.categoria)
            && request.resource.data.categoria == resource.data.categoria
            && request.resource.data.criadoPor == resource.data.criadoPor);

      allow delete: if false;
    }
  }
}