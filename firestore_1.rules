rules_version = '2';

// Regras do Painel de Chamados — Logística de Chip e iGreen Store
// Cole no Firebase Console → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado()   { return request.auth != null; }
    function email()    { return request.auth.token.email.lower(); }

    // Veem e gerenciam tudo
    function isAdmin() {
      return logado() && email() in [
        'agnes.angelim@igreenenergy.com.br',
        'anacarolina.araujo@igreenenergy.com.br'
      ];
    }
    // Responsáveis por área
    function isRespChip()  { return logado() && email() == 'mariajulia.mendes@igreenenergy.com.br'; }
    function isRespStore() { return logado() && email() == 'flavia.cunha@igreenenergy.com.br'; }

    function podeGerir(cat) {
      return isAdmin()
        || (cat == 'chip'  && isRespChip())
        || (cat == 'store' && isRespStore());
    }

    match /usuarios/{uid} {
      allow read, write: if logado() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    match /chamados/{id} {
      // Vê o chamado: admins e demais usuários veem todos;
      // Flavia e Maria Julia veem só a própria área + o que elas abriram
      allow read: if isAdmin()
        || (logado() && !isRespChip() && !isRespStore())
        || podeGerir(resource.data.categoria)
        || (logado() && resource.data.criadoPor.uid == request.auth.uid);

      // Qualquer usuário logado abre chamado, sempre como "aberto" e em uma das duas áreas
      allow create: if logado()
        && request.resource.data.criadoPor.uid == request.auth.uid
        && request.resource.data.categoria in ['chip', 'store']
        && request.resource.data.status == 'aberto';

      // Muda status / comenta: só quem gerencia a área
      allow update: if isAdmin()
        || (podeGerir(resource.data.categoria)
            && request.resource.data.categoria == resource.data.categoria
            && request.resource.data.criadoPor == resource.data.criadoPor);

      allow delete: if false;
    }
  }
}
